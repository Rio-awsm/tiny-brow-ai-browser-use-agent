{
  "name": "tiny-brow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A bring-your-own-key browser agent that lives in a Chrome side panel and drives the current tab.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "harness": "tsx harness/index.ts",
    "verify:tasks": "tsx harness/index.ts --verify-tasks",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "typecheck:node": "tsc -p tsconfig.node.json",
    "typecheck:ext": "wxt prepare && tsc --noEmit",
    "typecheck": "npm run typecheck:node && npm run typecheck:ext",
    "check": "npm run typecheck && npm run verify:tasks && npm run build && npm run check:secrets && npm run check:extractor",
    "icons": "tsx scripts/make-icons.ts",
    "check:extractor": "tsx scripts/check-extractor.ts",
    "bench": "tsx harness/index.ts --driver bridge",
    "matrix": "tsx harness/index.ts --compare"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.9",
    "@types/node": "^22.15.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.3",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.44.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.0.5",
    "zustand": "^5.0.15"
  }
}
