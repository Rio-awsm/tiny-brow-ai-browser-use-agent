# tiny-brow — local development configuration
#
# SCOPE: this file is read ONLY by Node-side scripts (scoring harness, benchmarks).
# The extension NEVER reads it. Vite inlines import.meta.env at build time, so a key
# here would be baked into the published bundle. In the extension the user supplies
# endpoint + key + model through the settings UI, stored in chrome.storage.local.
#
# Verified against live endpoints on 2026-09-10.

# ── Active provider for local testing ───────────────────────────────────────
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=gsk_your_key_here

# ── Groq ────────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Verified to honour response_format.json_schema with strict:true.
# Latency below measured on a 3-element index prompt.
GROQ_MODEL=openai/gpt-oss-20b               # 0.65s — default navigator
GROQ_MODEL_LARGE=openai/gpt-oss-120b        # 0.49s — planner / recovery (M14 router)
GROQ_MODEL_ALT=qwen/qwen3.8-27b             # 0.58s — alternate
# qwen/qwen3.6-27b                          # untested, TPM-limited during probe
#
# Rejected — endpoint returns "does not support response format json_schema":
#   groq/compound, groq/compound-mini, allam-2-7b
#
# Groq-only params, passed via the provider extraParams escape hatch.
# Measured on "reply with one word": neither alone is enough, both together are.
#   include_reasoning=false only              -> 51 completion tokens (reasoning still billed, just hidden)
#   + reasoning_effort=low                    -> 16 completion tokens (3.2x cheaper)
GROQ_INCLUDE_REASONING=false                # hides reasoning from the response
GROQ_REASONING_EFFORT=low                   # gpt-oss only: low | medium | high — this is what actually saves tokens
#
# TRAP: reasoning is generated BEFORE content. A tight max_tokens is consumed by it and
# returns empty content with finish_reason="length" — looks like model failure, is a budget bug.
# Keep max_tokens generous and treat finish_reason=="length" as a hard provider error.
LLM_MAX_TOKENS=1024
#
# Free-tier limits observed: 8000 tokens/min, 1000 requests/day.
# At a ~2.1k-token prompt that is only ~3-4 agent steps per minute.
GROQ_TPM_BUDGET=8000

# ── Other providers (same /chat/completions surface, swap and go) ────────────
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
#
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GOOGLE_API_KEY=
# GOOGLE_MODEL=gemini-2.5-flash
#
# LITELLM_BASE_URL=http://127.0.0.1:4000/v1
# LITELLM_API_KEY=
# LITELLM_MODEL=
#
# Local LM Studio — measured ~44s on the same 2.1k prompt (4GB GTX 1650, partial offload)
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# LMSTUDIO_API_KEY=lm-studio
# LMSTUDIO_MODEL=gemma-4-e4b-it
